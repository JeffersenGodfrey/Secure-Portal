PORT=5000
NODE_ENV=development

# ─── TiDB Cloud Serverless (free tier) ───────────────────────
# Default public-endpoint port is 4000; TLS is required.
# Copy the exact values from: TiDB Cloud Console → cluster →
# "Connect" → "Public Endpoint" → "Connection parameters".
MYSQL_HOST=...
MYSQL_USER=...
MYSQL_PASSWORD=...
MYSQL_DATABASE=...
MYSQL_PORT=4000
MYSQL_SSL=true

GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# Optional: set to your deployed callback URL in production, otherwise it
# defaults to http://localhost:PORT/auth/google/callback
GOOGLE_CALLBACK_URL=

CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

SESSION_SECRET=...
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=your-email@gmail.com